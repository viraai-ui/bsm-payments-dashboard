{
  "name": "bsm-payments-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:payments": "node scripts/verify-payment-lifecycle.cjs",
    "verify:payment-table": "node scripts/verify-payment-table.cjs",
    "verify:settlement": "node --experimental-strip-types scripts/verify-payment-settlement.mjs",
    "verify:auth": "node scripts/verify-auth-roles.cjs",
    "verify:salesperson-ownership": "node scripts/verify-salesperson-ownership.cjs",
    "verify:proofs": "node scripts/verify-payment-proofs.cjs",
    "verify:github-store": "node --experimental-strip-types scripts/verify-github-data-store.mjs",
    "verify:data-cache": "tsx scripts/verify-data-cache.mjs",
    "verify:viewer-metrics": "node scripts/verify-viewer-metrics.cjs",
    "verify:payment-actions": "node scripts/verify-payment-actions.cjs",
    "verify:split-claims": "tsx scripts/verify-split-claims.mts",
    "verify:notifications": "tsx scripts/verify-payment-notifications.mjs",
    "verify:live-sync": "tsx scripts/verify-live-sync.mjs",
    "verify:admin-contract": "node scripts/verify-admin-contract.cjs",
    "verify:payout-sync-ui": "node scripts/verify-payout-sync-ui.cjs",
    "verify:responsive": "node scripts/verify-responsive.cjs",
    "verify:tablet": "TABLET_ONLY=1 node scripts/verify-responsive.cjs",
    "verify:ui-interactions": "node scripts/verify-responsive.cjs",
    "verify:mobile-app": "node scripts/verify-mobile-app.cjs && node scripts/verify-responsive.cjs",
    "verify:zoho-orders": "node --experimental-strip-types scripts/verify-zoho-payment-orders.mjs",
    "verify:payouts-outbox": "tsx scripts/verify-payouts-outbox.mjs",
    "verify:payment-link-backfill": "node scripts/verify-payment-link-backfill.mjs",
    "audit:payment-links": "node --env-file=.env.local --experimental-strip-types scripts/payment-link-backfill.mjs",
    "verify:zoho-orders:live": "node --env-file=.env.local --experimental-strip-types scripts/verify-zoho-payment-orders-live.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^6.19.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "jose": "latest",
    "jspdf": "^4.2.1",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "web-push": "^3.6.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^6.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
