GITHUB_REPO="bsm-payments-dashboard" # read-only legacy migration source
GITHUB_DATA_REPO="bsm-payments-data"
GITHUB_DATA_BRANCH="main" # optional; omit to use the repository default branch
# APP_LOCAL_ONLY=true permits filesystem-backed development only. Never set it on Vercel.
APP_LOCAL_ONLY="false"
ZOHO_WEBHOOK_SECRET=""
WORKDRIVE_CLIENT_ID=""
WORKDRIVE_CLIENT_SECRET=""
WORKDRIVE_REFRESH_TOKEN=""
